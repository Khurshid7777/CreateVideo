#!/bin/sh
# Silicare: автопроверка перед каждым коммитом, если меняется что-то в silicare/.
# Установка: make silicare-hooks
if git diff --cached --name-only | grep -q '^silicare/'; then
  python3 -m silicare.check --errors-only || {
    echo "Silicare: автопроверка нашла ошибки, коммит остановлен."
    exit 1
  }
fi
